PORT=3000
HOST=0.0.0.0
GITHUB_TOKEN=
GITHUB_REPO=uploadbases/cdn0
GITHUB_BRANCH=raw
GITHUB_API_BASE=https://api.github.com
GITHUB_COMMIT_EMAIL=auto@auto.com
GITHUB_COMMIT_NAME=none
# HMAC secret for signed download links. Empty = links never expire.
# Generate: openssl rand -hex 32
DOWNLOAD_SECRET=

# Signed link lifetime in seconds (default 7 days).
DOWNLOAD_TTL=604800

DOWNLOAD_URLS=

# Bytes per chunk for large uploads. Smaller chunks mean a failed chunk costs
# less to re-send, at the price of more round trips. Default 8388608 (8MB).
CHUNK_SIZE=
# Chunks the server will process at once. Also published to clients so they can
# size their own in-flight window to the capacity that exists. Default 8.
MAX_CONCURRENT_CHUNKS=
